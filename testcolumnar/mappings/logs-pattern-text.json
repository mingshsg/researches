{
  "dynamic": "strict",
  "properties": {
    "@timestamp": { "type": "date" },
    "host": {
      "properties": {
        "name": { "type": "keyword" }
      }
    },
    "service": {
      "properties": {
        "name": { "type": "keyword" },
        "version": { "type": "keyword" }
      }
    },
    "log": {
      "properties": {
        "level": { "type": "keyword" }
      }
    },
    "http": {
      "properties": {
        "request": {
          "properties": {
            "method": { "type": "keyword" }
          }
        },
        "response": {
          "properties": {
            "status_code": { "type": "long" },
            "bytes": { "type": "long" }
          }
        }
      }
    },
    "url": {
      "properties": {
        "path": { "type": "keyword" }
      }
    },
    "source": {
      "properties": {
        "ip": { "type": "ip" }
      }
    },
    "event": {
      "properties": {
        "duration": { "type": "long" }
      }
    },
    "trace": {
      "properties": {
        "id": { "type": "keyword" }
      }
    },
    "message": { "type": "pattern_text" }
  }
}
